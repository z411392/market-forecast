{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-forecast.io/schemas/context/capabilities.schema.json",
  "title": "Context Capabilities Schema",
  "type": "object",
  "required": ["version", "capabilities"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "aliases", "owner", "module_roots", "authority_refs"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/authority_class"
          },
          "module_roots": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "authority_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "index_routes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": {
            "type": "string"
          },
          "symbols": { "not": {}, "description": "Symbols must remain generated facts" },
          "callers": { "not": {}, "description": "Callers must remain generated facts" },
          "imports": { "not": {}, "description": "Imports must remain generated facts" },
          "tests": { "not": {}, "description": "Tests must remain generated facts" },
          "relations": { "not": {}, "description": "Relations must remain generated facts" },
          "spec_body": { "not": {}, "description": "Spec bodies must not be embedded" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
