{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-forecast.io/schemas/context/authority-routing.schema.json",
  "title": "Context Authority Routing Schema",
  "type": "object",
  "required": ["version", "authorities"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "class", "provenance"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_:-]+$"
          },
          "authority_id": {
            "type": "string",
            "pattern": "^[a-z0-9_:-]+$"
          },
          "path": {
            "type": "string"
          },
          "class": {
            "$ref": "common.schema.json#/$defs/authority_class"
          },
          "scope_kind": {
            "$ref": "common.schema.json#/$defs/scope_kind"
          },
          "domain": {
            "$ref": "common.schema.json#/$defs/authority_domain"
          },
          "provenance": {
            "$ref": "common.schema.json#/$defs/provenance"
          },
          "provenance_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string"
          },
          "write_target": {
            "type": "string",
            "enum": ["WRITE_TARGET", "NOT_WRITE_TARGET", "CONDITIONAL_WRITE"]
          },
          "responsibility_class": {
            "type": "string"
          },
          "canonical_owner": {
            "type": "string"
          },
          "parent_authority_id": {
            "type": "string"
          },
          "public_contract_refs": {
            "oneOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" }
            ]
          },
          "current_projection_ref": {
            "type": "string"
          },
          "receipt_refs": {
            "oneOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" }
            ]
          },
          "manifest_refs": {
            "oneOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" }
            ]
          },
          "supersedes": {
            "oneOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" }
            ]
          },
          "amends": {
            "oneOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" }
            ]
          },
          "implements": {
            "oneOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" }
            ]
          },
          "candidate_for": {
            "oneOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" }
            ]
          },
          "historical_reference_of": {
            "oneOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "string" }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
